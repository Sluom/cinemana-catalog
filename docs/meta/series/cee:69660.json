{"meta":{"id":"cee:69660","type":"series","name":"يوزر سيف","poster":"https://cnth2.cee.buzz/vascin-poster-images/4EA12E9D-23E7-B19E-59FC-9C2C897A2D37_poster.png","background":"https://cnth2.cee.buzz/vascin-poster-images/4EA12E9D-23E7-B19E-59FC-9C2C897A2D37_poster.png","description":"يوسف الصديق (بالفارسية: يوسف پیامبر) مسلسل تاريخي إيراني يحكي قصة النبي يوسف بن يعقوب بن إسحاق بن إبراهيم الخليل (عليهم السلام) منذ ولادته إلى لقائه بأبيه نبي الله يعقوب بعد غياب طويل. المسلسل من 45 حلقة استغرق تصويره ثلاث سنوات تقريباً منذ 2005م إلى 2008م.\n\n\n\nالمسلسل يحكي قصة نبي الله يوسف، التي وردت قصته في القرآن الكريم في سورة يوسف؛ و وردت قصته في السنة النبوية","releaseInfo":"2008","genres":["مدبلج عربي","دراما","تاريخي"],"cast":["إلهام حميدي","كتايون رياحي","مصطفى زماني"],"director":[],"imdbRating":"8.0","runtime":"48 min","videos":[{"id":"cee:69660","title":"الموسم 1 - الحلقة 1","season":1,"episode":1,"thumbnail":"https://cnth2.cee.buzz/vascin-poster-images/4EA12E9D-23E7-B19E-59FC-9C2C897A2D37_poster.png","released":"2008-01-01T00:00:00.000Z"},{"id":"cee:69661","title":"الموسم 1 - الحلقة 2","season":1,"episode":2,"thumbnail":"https://cnth2.cee.buzz/vascin-poster-images/6BCC9774-78F3-7B0B-7DA8-230FE01AFB82_poster.png","released":"2008-01-02T00:00:00.000Z"},{"id":"cee:69662","title":"الموسم 1 - الحلقة 3","season":1,"episode":3,"thumbnail":"https://cnth2.cee.buzz/vascin-poster-images/6BCC9774-78F3-7B0B-7DA8-230FE01AFB82_poster.png","released":"2008-01-03T00:00:00.000Z"},{"id":"cee:69663","title":"الموسم 1 - الحلقة 4","season":1,"episode":4,"thumbnail":"https://cnth2.cee.buzz/vascin-poster-images/6BCC9774-78F3-7B0B-7DA8-230FE01AFB82_poster.png","released":"2008-01-04T00:00:00.000Z"},{"id":"cee:69664","title":"الموسم 1 - الحلقة 5","season":1,"episode":5,"thumbnail":"https://cnth2.cee.buzz/vascin-poster-images/6BCC9774-78F3-7B0B-7DA8-230FE01AFB82_poster.png","released":"2008-01-05T00:00:00.000Z"},{"id":"cee:69665","title":"الموسم 1 - الحلقة 6","season":1,"episode":6,"thumbnail":"ht